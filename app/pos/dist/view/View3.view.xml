
<mvc:View
    controllerName="pos.controller.View3"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns="sap.m">

    <Page id="_IDGenPage"
        title="Create Purchase Order"
        showNavButton="true"
        navButtonPress="onCancel">

        <content>
            <VBox id="_IDGenVBox" class="sapUiMediumMargin" width="100%">
                <Title id="_IDGenTitle1" text="Purchase Order Header" level="H2"/>

                <Label id="_IDGenLabel" text="PO Number" required="true"/>
                <Input
                    id="poNumber"
                    placeholder="Enter PO number"
                    required="true"/>

                <Label id="_IDGenLabel1" text="Supplier" required="true"/>
                <Input
                    id="supplier"
                    placeholder="Enter supplier name"
                    required="true"/>

                <Label id="_IDGenLabel2" text="Currency" required="true"/>
                <Select id="currency" selectedKey="USD" width="100%">
                    <items>
                        <core:Item id="_IDGenItem" key="USD" text="USD"/>
                        <core:Item id="_IDGenItem1" key="INR" text="INR"/>
                        <core:Item id="_IDGenItem2" key="EUR" text="EUR"/>
                    </items>
                </Select>

                <Label id="_IDGenLabel3" text="Total Amount" required="true"/>
                <Input
                    id="totalAmount"
                    type="Number"
                    placeholder="Enter total amount"
                    required="true"/>

                <Toolbar id="_IDGenToolbar1" class="sapUiSmallMarginTop">
                    <ToolbarSpacer id="_IDGenToolbarSpacer"/>
                    <Button id="_IDGenButton1"
                        text="Cancel"
                        press="onCancel"/>
                    <Button id="_IDGenButton2"
                        text="Submit"
                        type="Emphasized"
                        press="onSubmit"/>
                </Toolbar>
            </VBox>
        </content>
    </Page>
</mvc:View>
